{
  "name": "zodbase",
  "version": "0.0.2",
  "main": "src/index.ts",
  "scripts": {
    "test": "bun test --timeout 40000 --pass-with-no-tests && bun run test:types",
    "test:compiled": "bun test --preload zod/compile --timeout 40000 --pass-with-no-tests && bun run test:types",
    "test:types": "tsc --noEmit --project tsconfig.types.json && bun run test:provider-types",
    "check:fix": "tsc --noEmit --project tsconfig.json && npx @biomejs/biome check --write .",
    "check": "tsc --noEmit --project tsconfig.json && npx @biomejs/biome check .",
    "docs:dev": "cd website && bun run start",
    "docs:build": "cd website && bun run build",
    "test:provider-types": "tsc --noEmit --project tsconfig.providers.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Censkh/zodbase.git"
  },
  "homepage": "https://zodbase.knownquantity.net/",
  "exports": {
    ".": {
      "workerd": "./src/index.ts",
      "browser": "./src/index.browser.ts",
      "default": "./src/index.ts"
    },
    "./adaptors/*": {
      "workerd": "./src/adaptors/*/index.ts",
      "browser": "./src/adaptors/*/index.browser.ts",
      "default": "./src/adaptors/*/index.ts"
    },
    "./rsql": "./src/rsql/index.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "zod": "~4.6.5",
    "@rsql/parser": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@libsql/client": "^0.17.4",
    "@neondatabase/serverless": "^1.1.0",
    "@testcontainers/cockroachdb": "^12.1.0",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "^1.4.2",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "pg": "^8.22.0",
    "typescript": "7.0.2",
    "zod": "~4.6.5",
    "zod-compiler": "^2.0.5"
  },
  "dependencies": {
    "server-only": "^0.0.1",
    "sql-escape-string": "^1.1.0",
    "zod-meta": "^0.4.1"
  }
}
